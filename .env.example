# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/pzskill_admin
DB_NAME=PZskillAdmin
SKILL_GAME_DB_NAME=PZskillDB

# Dus Ka Dum Postgres (same DATABASE_URL as dus-ka-dum-backend). Optional — if unset, dus tickets are omitted from reports.
DUS_KA_DUM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pzskill_dkd

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-key-here-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173
